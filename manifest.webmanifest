{
  "id": "./main.html",
  "name": "PDF Flow Animator",
  "short_name": "Flow Animator",
  "description": "Anime desenhos, setas e comentários sobre PDFs e imagens e exporte como vídeo — direto no navegador.",
  "lang": "pt-BR",
  "start_url": "./main.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111318",
  "theme_color": "#181b21",
  "categories": ["productivity", "education", "graphics"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./main.html",
      "accept": {
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "application/json": [".json"]
      }
    }
  ]
}
